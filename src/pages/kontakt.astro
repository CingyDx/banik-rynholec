---
import { CalendarDays, Camera, MapPin, Phone } from "lucide-react";

import PageHero from "../components/public/PageHero.astro";
import { club, teams } from "../content/site";
import PublicLayout from "../layouts/PublicLayout.astro";

const youthTeam = teams.find((team) => team.id === "zaci") ?? teams[1];
const youthPhoneHref = youthTeam.phone?.replace(/\s/g, "");
---

<PublicLayout title="Kontakt" description="Ověřené kontakty a mapa areálu TJ Baník Rynholec.">
  <PageHero title="Kontakt" description="Adresa areálu, kontakt na starší žáky a klubový kalendář." />

  <section class="content-band">
    <div class="container contact-page">
      <article class="map-card">
        <div class="map-image media-frame">
          <img src="/images/sportovni-areal-secondary.jpg" alt="Sportovní areál TJ Baník Rynholec" width="1200" height="750" />
        </div>
        <div>
          <span class="contact-label">Adresa</span>
          <h2>{club.address}</h2>
          <p>Sportovní areál TJ Baník Rynholec najdete u hřiště v Rynholci.</p>
          <a class="command command--primary" href={`https://www.google.com/maps?q=${club.coordinates.latitude},${club.coordinates.longitude}`} target="_blank" rel="noreferrer">
            Otevřít mapu <MapPin aria-hidden="true" size={18} />
          </a>
        </div>
      </article>

      <div class="contact-grid">
        <article>
          <Phone aria-hidden="true" size={26} strokeWidth={1.8} />
          <span class="contact-label">Starší žáci</span>
          <h2>{youthTeam.coach}</h2>
          <p>Trenér starších žáků a kontakt pro nové hráče.</p>
          {youthPhoneHref && <a class="text-link" href={`tel:${youthPhoneHref}`}>{youthTeam.phone}</a>}
        </article>
        <article>
          <Camera aria-hidden="true" size={26} strokeWidth={1.8} />
          <span class="contact-label">Mládež online</span>
          <h2>Instagram</h2>
          <p>Fotky a další dění kolem žákovského týmu.</p>
          {youthTeam.instagram && <a class="text-link" href={youthTeam.instagram} target="_blank" rel="noreferrer">banikrynholeczaci</a>}
        </article>
        <article class="wide">
          <CalendarDays aria-hidden="true" size={26} strokeWidth={1.8} />
          <span class="contact-label">Správa areálu</span>
          <h2>Kalendář areálu</h2>
          <p>Aktuální program, provozní informace a obsazenost hřiště najdete v klubovém kalendáři.</p>
          <a class="text-link" href="/kalendar">Otevřít kalendář</a>
        </article>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 2.5rem;
    align-items: stretch;
  }

  .map-card {
    border: 1px solid var(--color-line);
    background: var(--color-white);
    box-shadow: 0 18px 50px rgb(9 11 9 / 7%);
  }

  .map-image {
    min-height: 360px;
    border: 0;
  }

  .map-card div:not(.map-image) {
    padding: 2rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .contact-grid article {
    min-height: 230px;
    padding: 1.5rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .contact-grid .wide {
    grid-column: span 2;
  }

  .contact-grid svg {
    margin-bottom: 1rem;
    color: var(--color-green);
  }

  .contact-label {
    color: var(--color-green);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
  }

  h2 {
    margin: 1rem 0 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: 2.45rem;
    line-height: 1;
    text-transform: uppercase;
  }

  p {
    margin: 1rem 0 2rem;
    color: var(--color-muted);
  }

  @media (max-width: 850px) {
    .contact-page,
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-grid .wide {
      grid-column: auto;
    }

    .map-image {
      min-height: 240px;
    }
  }
</style>
